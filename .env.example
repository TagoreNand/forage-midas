# Copy to `.env` and adjust. `.env` is git-ignored — never commit real secrets (Roadmap §4.3).

# Database
DB_NAME=midas
DB_USER=midas
DB_PASSWORD=change-me
DB_HOST=postgres
DB_PORT=5432

# Kafka
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
MIDAS_KAFKA_TOPIC=midas-transactions
MIDAS_EVENTS_TOPIC=midas-domain-events

# External incentive/rewards service
INCENTIVE_API_URL=http://localhost:8080

# Grafana
GRAFANA_PASSWORD=admin
